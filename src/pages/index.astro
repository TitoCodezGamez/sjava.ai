import Hero from '../components/Hero.astro';
import Contact from '../components/Contact.astro';
import CoffeeModal from '../components/CoffeeModal.astro';
---

<BaseLayout>
  <main>
    <Hero />
    <Contact />
  </main>

  {/* Booking lives in a dialog, opened by anything with [data-coffee-open] */}
  <CoffeeModal />
</BaseLayout>
