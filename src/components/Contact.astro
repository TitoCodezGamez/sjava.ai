---
import { EMAIL as email, LINKEDIN as linkedin } from '../config';
---

<section class="section contact" id="contact">
  <div class="section__inner contact__inner">
    <header class="section__header" data-reveal>
      <span class="section__label">Contact</span>
      <h2 class="section__title">Get in touch</h2>
      <p class="section__subtitle">
        For advisory work, speaking engagements, and press enquiries. To arrange a
        short conversation instead, <button type="button" class="contact__inline-btn" data-coffee-open>book a coffee</button>.
      </p>
    </header>

    <form class="contact__form" data-contact-form data-email={email} novalidate data-reveal data-reveal-delay="1">
      {/* No email field: the message goes out from the sender's own account,
          so their address is already in the From header. Asking for it again
          only invites a reply-to that contradicts where the mail came from. */}
      <div class="contact__row">
        <div class="field">
          <label class="field__label" for="cf-name">Name</label>
          <input class="field__input" id="cf-name" name="name" type="text" required autocomplete="name" />
        </div>
        <div class="field">
          <label class="field__label" for="cf-subject">Subject</label>
          <input class="field__input" id="cf-subject" name="subject" type="text" required />
        </div>
      </div>

      <div class="field">
        <label class="field__label" for="cf-message">Message</label>
        <textarea class="field__input field__input--area" id="cf-message" name="message" rows="6" required></textarea>
      </div>

      <div class="contact__submit">
        <button type="submit" class="btn btn--primary">Send message</button>
      </div>
    </form>

    <p class="contact__alt" data-reveal data-reveal-delay="2">
      Or reach me directly at <a href={`mailto:${email}`}>{email}</a>
      {' · '}
      <a href={linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>
    </p>
  </div>
</section>

<script>
  // No backend on a static host, so the form hands off to Gmail's compose
  // window rather than POSTing. Swap this handler for a fetch() to Formspree
  // or a Pages Function if real server-side delivery is wanted later.
  import { gmailCompose } from '../config';

  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');

  if (form) {
    const email = form.dataset.email || '';

    const setError = (field: HTMLElement, message: string) => {
      const wrap = field.closest('.field')!;
      wrap.classList.toggle('field--error', Boolean(message));
      let el = wrap.querySelector('.field__error');
      if (message) {
        if (!el) {
          el = document.createElement('p');
          el.className = 'field__error';
          wrap.appendChild(el);
        }
        el.textContent = message;
      } else if (el) {
        el.remove();
      }
    };

    form.addEventListener('submit', (e) => {
      e.preventDefault();

      const el = form.elements as any;
      const name = el.name as HTMLInputElement;
      const subject = el.subject as HTMLInputElement;
      const message = el.message as HTMLTextAreaElement;

      // Validate before handing off: the compose tab opens either way, and a
      // half-empty draft landing in Sara's inbox is worse than an inline error.
      let firstBad: HTMLElement | null = null;
      const checks: [HTMLElement, string][] = [
        [name, name.value.trim() ? '' : 'Please enter your name.'],
        [subject, subject.value.trim() ? '' : 'Please enter a subject.'],
        [message, message.value.trim() ? '' : 'Please enter a message.'],
      ];

      checks.forEach(([field, error]) => {
        setError(field, error);
        if (error && !firstBad) firstBad = field;
      });

      if (firstBad) {
        firstBad.focus();
        return;
      }

      const url = gmailCompose({
        to: email,
        subject: subject.value.trim(),
        body: `${message.value.trim()}\n\n${name.value.trim()}`,
      });

      window.open(url, '_blank', 'noopener,noreferrer');
    });
  }
</script>

<style>
  .contact__inner {
    max-width: 44rem;
  }

  .contact__inline-btn {
    color: var(--color-accent);
    font: inherit;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .contact__inline-btn:hover {
    color: var(--color-accent-hover);
  }

  .contact__form {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .contact__row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-md);
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    min-width: 0;
  }

  .field__label {
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-text-primary);
  }

  .field__input {
    width: 100%;
    padding: 0.6rem 0.75rem;
    font: inherit;
    font-size: var(--text-sm);
    color: var(--color-text-primary);
    background-color: var(--color-surface-elevated);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    transition: border-color var(--transition-fast);
  }

  .field__input:focus {
    outline: none;
    border-color: var(--color-accent);
  }

  .field__input--area {
    resize: vertical;
    min-height: 8rem;
  }

  .field--error .field__input {
    border-color: #c0392b;
  }

  .field__error {
    font-size: var(--text-xs);
    color: #c0392b;
  }

  .contact__submit {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-sm) var(--space-md);
  }

  .contact__alt {
    margin-top: var(--space-lg);
    font-size: var(--text-sm);
    color: var(--color-text-subtle);
  }

  .contact__alt a {
    color: var(--color-accent);
  }

  .contact__alt a:hover {
    text-decoration: underline;
  }

  @media (max-width: 560px) {
    .contact__row {
      grid-template-columns: 1fr;
    }
  }
</style>
