---
import { EMAIL as email } from '../config';
---

<dialog class="coffee" id="coffee-modal" data-email={email} aria-labelledby="coffee-title">
  <div class="coffee__head">
    <div>
      <h2 class="coffee__title" id="coffee-title">Book a coffee</h2>
      <p class="coffee__sub">30 minutes · times shown in Pacific Time</p>
    </div>
    <button type="button" class="coffee__close" data-close aria-label="Close">
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true">
        <path d="M4 4l8 8M12 4l-8 8" />
      </svg>
    </button>
  </div>

  <div class="coffee__body">
    <!-- Left: month calendar -->
    <section class="coffee__cal" aria-label="Choose a date">
      <div class="coffee__cal-head">
        <button type="button" class="coffee__nav" data-prev aria-label="Previous month">
          <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 3L5 8l5 5" /></svg>
        </button>
        <p class="coffee__month" data-month aria-live="polite"></p>
        <button type="button" class="coffee__nav" data-next aria-label="Next month">
          <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 3l5 5-5 5" /></svg>
        </button>
      </div>

      <div class="coffee__dow" aria-hidden="true">
        <span>Sun</span><span>Mon</span><span>Tue</span><span>Wed</span><span>Thu</span><span>Fri</span><span>Sat</span>
      </div>

      <div class="coffee__grid" data-grid role="grid"></div>

      <p class="coffee__legend"><span class="coffee__legend-dot" aria-hidden="true"></span> times available</p>
    </section>

    <!-- Right: times for the selected date -->
    <section class="coffee__slots" aria-label="Choose a time">
      <p class="coffee__slots-head" data-slots-head>Select a date to see available times</p>
      <div class="coffee__times" data-times></div>
      <div class="coffee__confirm" data-confirm hidden></div>
    </section>
  </div>
</dialog>

<script>
  import { CAL, gmailCompose } from '../config';

  // Real booking against Cal.com. Its v2 slots and bookings endpoints are
  // unauthenticated and CORS-open, so this runs straight from the static page
  // with no backend and no secret. Cal.com owns availability, duration and
  // buffers; this file only renders what the API returns, which means changing
  // her hours in Cal.com changes the site with no redeploy.
  //
  // Date keys ("2026-07-28") come back as plain dates already in her timezone,
  // so the calendar grid is built from strings and needs no timezone maths.
  const API = 'https://api.cal.com/v2';
  const HORIZON_DAYS = 60;

  const dialog = document.getElementById('coffee-modal') as HTMLDialogElement | null;

  if (dialog) {
    const gridEl = dialog.querySelector<HTMLElement>('[data-grid]')!;
    const monthEl = dialog.querySelector<HTMLElement>('[data-month]')!;
    const timesEl = dialog.querySelector<HTMLElement>('[data-times]')!;
    const slotsHeadEl = dialog.querySelector<HTMLElement>('[data-slots-head]')!;
    const confirmEl = dialog.querySelector<HTMLElement>('[data-confirm]')!;
    const prevBtn = dialog.querySelector<HTMLButtonElement>('[data-prev]')!;
    const nextBtn = dialog.querySelector<HTMLButtonElement>('[data-next]')!;

    const fmtMonth = new Intl.DateTimeFormat('en-US', { timeZone: 'UTC', month: 'long', year: 'numeric' });
    const fmtFull = new Intl.DateTimeFormat('en-US', {
      timeZone: CAL.timeZone, weekday: 'long', month: 'long', day: 'numeric',
    });
    const fmtTime = new Intl.DateTimeFormat('en-US', {
      timeZone: CAL.timeZone, hour: 'numeric', minute: '2-digit',
    });
    const visitorTz = Intl.DateTimeFormat().resolvedOptions().timeZone || CAL.timeZone;

    /** Today as a plain YYYY-MM-DD in her timezone, for bounding the fetch. */
    const todayKey = new Intl.DateTimeFormat('en-CA', {
      timeZone: CAL.timeZone, year: 'numeric', month: '2-digit', day: '2-digit',
    }).format(new Date());

    const pad = (n: number) => String(n).padStart(2, '0');
    const keyOf = (y: number, m: number, d: number) => `${y}-${pad(m + 1)}-${pad(d)}`;

    let viewY = Number(todayKey.slice(0, 4));
    let viewM = Number(todayKey.slice(5, 7)) - 1;
    let slots: Record<string, string[]> = {};   // date key -> ISO start times
    let selectedKey: string | null = null;
    let selectedStart: string | null = null;
    /** Survives stepping back to the time list, so nothing is retyped. */
    const draft = { name: '', email: '', reason: '' };
    let loading = false;
    let loadError = false;
    /** -1 back, 1 forward, 0 none. Consumed once the new month has rendered. */
    let pendingDir = 0;

    // Cache per month so paging back and forth does not refetch
    const cache = new Map<string, Record<string, string[]>>();

    const horizonKey = (() => {
      const d = new Date(`${todayKey}T12:00:00Z`);
      d.setUTCDate(d.getUTCDate() + HORIZON_DAYS);
      return d.toISOString().slice(0, 10);
    })();

    async function loadMonth() {
      const monthKey = `${viewY}-${pad(viewM + 1)}`;
      if (cache.has(monthKey)) {
        slots = cache.get(monthKey)!;
        render();
        return;
      }

      const daysInMonth = new Date(Date.UTC(viewY, viewM + 1, 0)).getUTCDate();
      // Never ask for dates outside the bookable window
      const from = keyOf(viewY, viewM, 1) < todayKey ? todayKey : keyOf(viewY, viewM, 1);
      const to = keyOf(viewY, viewM, daysInMonth) > horizonKey ? horizonKey : keyOf(viewY, viewM, daysInMonth);

      loading = true;
      loadError = false;
      render();

      try {
        if (from > to) {
          slots = {};
        } else {
          const url =
            `${API}/slots?eventTypeId=${CAL.eventTypeId}` +
            `&start=${from}&end=${to}&timeZone=${encodeURIComponent(CAL.timeZone)}`;
          const res = await fetch(url, { headers: { 'cal-api-version': CAL.slotsApiVersion } });
          if (!res.ok) throw new Error(`slots ${res.status}`);
          const json = await res.json();
          slots = {};
          for (const [day, list] of Object.entries((json.data || {}) as Record<string, { start: string }[]>)) {
            if (list.length) slots[day] = list.map((s) => s.start);
          }
        }
        cache.set(monthKey, slots);
      } catch {
        // Availability is unknown rather than empty: say so instead of showing
        // an empty calendar that looks like she is fully booked.
        slots = {};
        loadError = true;
      } finally {
        loading = false;
        render();
      }
    }

    function render() {
      renderMonth();
      renderTimes();
    }

    function renderMonth() {
      monthEl.textContent = fmtMonth.format(new Date(Date.UTC(viewY, viewM, 1)));
      prevBtn.disabled = loading || keyOf(viewY, viewM, 1) <= todayKey;
      nextBtn.disabled = loading || keyOf(viewY, viewM + 1, 1) > horizonKey;

      gridEl.innerHTML = '';
      gridEl.classList.toggle('is-loading', loading);

      const startDow = new Date(Date.UTC(viewY, viewM, 1)).getUTCDay();
      const daysInMonth = new Date(Date.UTC(viewY, viewM + 1, 0)).getUTCDate();

      for (let i = 0; i < startDow; i++) {
        const blank = document.createElement('span');
        blank.className = 'coffee__day coffee__day--blank';
        gridEl.appendChild(blank);
      }

      for (let day = 1; day <= daysInMonth; day++) {
        const key = keyOf(viewY, viewM, day);
        const open = Boolean(slots[key]?.length);

        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'coffee__day';
        btn.disabled = !open;
        btn.setAttribute('aria-pressed', String(selectedKey === key));
        btn.innerHTML =
          `<span class="coffee__day-num">${day}</span>` +
          (open ? '<span class="coffee__day-dot" aria-hidden="true"></span>' : '');

        if (open) {
          const count = slots[key].length;
          btn.setAttribute('aria-label',
            `${fmtFull.format(new Date(slots[key][0]))}, ${count} time${count === 1 ? '' : 's'} available`);
          btn.addEventListener('click', () => {
            selectedKey = key;
            selectedStart = null;
            confirmEl.hidden = true;
            render();
          });
        }

        gridEl.appendChild(btn);
      }

      // Play the slide only once the real days are on screen. Firing it on the
      // click would animate the dimmed loading grid and then snap when the
      // fetch landed.
      if (pendingDir && !loading) {
        const cls = pendingDir > 0 ? 'is-from-right' : 'is-from-left';
        gridEl.classList.remove('is-from-right', 'is-from-left');
        void gridEl.offsetWidth; // restart the animation rather than let it no-op
        gridEl.classList.add(cls);
        monthEl.classList.remove('is-from-right', 'is-from-left');
        void monthEl.offsetWidth;
        monthEl.classList.add(cls);
        pendingDir = 0;
      }
    }

    /** Restart an entry animation that may already be on the element. */
    function flash(el: HTMLElement) {
      el.classList.remove('is-entering');
      void el.offsetWidth;
      el.classList.add('is-entering');
    }

    // `animate` is only set by the two paths that swap the list and the panel,
    // so loading a month or changing date does not make things jump about.
    function renderTimes(animate = false) {
      timesEl.innerHTML = '';

      // Once a time is picked the list steps aside so the panel is the only
      // thing to deal with. The back control returns here.
      timesEl.hidden = Boolean(selectedStart);
      if (selectedStart) {
        renderConfirm();
        if (animate) flash(confirmEl);
        return;
      }
      confirmEl.hidden = true;
      if (animate) flash(timesEl);

      if (loading) {
        slotsHeadEl.textContent = 'Loading availability…';
        return;
      }
      if (loadError) {
        slotsHeadEl.textContent = 'Could not load availability';
        timesEl.innerHTML =
          `<p class="coffee__error">Something went wrong reaching the calendar. ` +
          `<a href="${gmailCompose({ subject: 'Coffee chat', body: 'Hi Sara,\n\nI would like to book a coffee chat.\n\n' })}" target="_blank" rel="noopener noreferrer">Email instead</a>.</p>`;
        return;
      }
      if (!selectedKey) {
        slotsHeadEl.textContent = 'Select a date to see available times';
        return;
      }

      const list = slots[selectedKey] || [];
      slotsHeadEl.textContent = `${fmtFull.format(new Date(list[0]))} · ${CAL.tzLabel}`;

      list.forEach((iso) => {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'coffee__time';
        btn.textContent = fmtTime.format(new Date(iso));
        btn.addEventListener('click', () => {
          selectedStart = iso;
          renderTimes(true);
        });
        timesEl.appendChild(btn);
      });
    }

    // Note: this markup is a JS template string, not Astro template, so a
    // {/* ... */} comment inside it renders as literal text. Comment out here.
    // The reason input maps to the event type's required "title" field, which
    // Cal.com labels "What is this meeting about?" and uses as the event title.
    function renderConfirm() {
      if (!selectedStart) return;
      // Full form for the emails and the success line; the card itself shows
      // only the time, since the header directly above it already has the date.
      const when = `${fmtFull.format(new Date(selectedStart))} at ${fmtTime.format(new Date(selectedStart))} ${CAL.tzLabel}`;
      const whenShort = `${fmtTime.format(new Date(selectedStart))} ${CAL.tzLabel}`;

      // Values are read back out of `draft`, so stepping back to the times and
      // returning does not wipe what they typed.
      const esc = (s: string) =>
        s.replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/</g, '&lt;');

      confirmEl.hidden = false;
      confirmEl.innerHTML = `
        <div class="coffee__confirm-head">
          <p class="coffee__summary">${whenShort}</p>
          <button type="button" class="coffee__back" data-bk-back aria-label="Back to times">
            <svg width="15" height="15" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true">
              <path d="M4 4l8 8M12 4l-8 8" />
            </svg>
          </button>
        </div>
        <div class="coffee__fields">
          <input class="coffee__input" data-bk-name type="text" placeholder="Your name" autocomplete="name" value="${esc(draft.name)}" />
          <input class="coffee__input" data-bk-email type="email" placeholder="Your email" autocomplete="email" value="${esc(draft.email)}" />
        </div>
        <input class="coffee__input coffee__input--wide" data-bk-reason type="text"
               placeholder="What is this meeting about?" value="${esc(draft.reason)}" />
        <div class="coffee__actions">
          <button type="button" class="btn btn--primary" data-book>Confirm booking</button>
        </div>
        <p class="coffee__note" data-bk-note>Sara confirms each request by email.</p>
      `;

      const nameEl = confirmEl.querySelector<HTMLInputElement>('[data-bk-name]')!;
      const emailEl = confirmEl.querySelector<HTMLInputElement>('[data-bk-email]')!;
      const reasonEl = confirmEl.querySelector<HTMLInputElement>('[data-bk-reason]')!;
      const bookBtn = confirmEl.querySelector<HTMLButtonElement>('[data-book]')!;
      const noteEl = confirmEl.querySelector<HTMLElement>('[data-bk-note]')!;

      nameEl.addEventListener('input', () => { draft.name = nameEl.value; });
      emailEl.addEventListener('input', () => { draft.email = emailEl.value; });
      reasonEl.addEventListener('input', () => { draft.reason = reasonEl.value; });

      confirmEl.querySelector('[data-bk-back]')!.addEventListener('click', () => {
        selectedStart = null;
        renderTimes(true);
      });

      bookBtn.addEventListener('click', async () => {
        const name = nameEl.value.trim();
        const email = emailEl.value.trim();
        const reason = reasonEl.value.trim();
        if (!name || !email || !emailEl.checkValidity() || !reason) {
          noteEl.textContent = 'Please add your name, a valid email, and what the meeting is about.';
          (!name ? nameEl : !email || !emailEl.checkValidity() ? emailEl : reasonEl).focus();
          return;
        }

        bookBtn.disabled = true;
        noteEl.textContent = 'Booking…';

        try {
          const res = await fetch(`${API}/bookings`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'cal-api-version': CAL.bookingsApiVersion },
            body: JSON.stringify({
              start: selectedStart,
              eventTypeId: CAL.eventTypeId,
              // Her timezone runs the calendar; the attendee's own zone is what
              // Cal.com uses to word their confirmation email.
              attendee: { name, email, timeZone: visitorTz, language: 'en' },
              // `title` is the event type's "What is this meeting about?"
              // field and is required, so a booking without it is rejected.
              // It also becomes the calendar event title, which is why the
              // reason belongs here rather than in the notes textarea.
              bookingFieldsResponses: { title: reason },
            }),
          });
          if (!res.ok) throw new Error(`booking ${res.status}`);

          confirmEl.innerHTML = `
            <p class="coffee__summary">Requested: ${when}</p>
            <p class="coffee__note">Sara will confirm by email at ${esc(email)}.</p>
          `;
          // That slot is spoken for; drop it so the grid cannot offer it twice
          cache.clear();
          selectedStart = null;
          loadMonth();
        } catch {
          bookBtn.disabled = false;
          const fallback = gmailCompose({
            subject: `Coffee chat: ${when}`,
            body: `Hi Sara,\n\nI would like to book a coffee chat on ${when}.\n\n${reason}\n\n${name}`,
          });
          noteEl.innerHTML =
            `That did not go through. <a href="${fallback}" target="_blank" rel="noopener noreferrer">Send it as an email instead</a>.`;
        }
      });
    }

    prevBtn.addEventListener('click', () => {
      pendingDir = -1;
      viewM -= 1;
      if (viewM < 0) { viewM = 11; viewY -= 1; }
      selectedKey = null;
      selectedStart = null;
      confirmEl.hidden = true;
      loadMonth();
    });

    nextBtn.addEventListener('click', () => {
      pendingDir = 1;
      viewM += 1;
      if (viewM > 11) { viewM = 0; viewY += 1; }
      selectedKey = null;
      selectedStart = null;
      confirmEl.hidden = true;
      loadMonth();
    });

    // ── Open / close ───────────────────────────────────────────────────────
    let loadedOnce = false;
    document.querySelectorAll('[data-coffee-open]').forEach((el) => {
      el.addEventListener('click', (e) => {
        e.preventDefault();
        dialog.showModal();
        // Fetch on first open rather than page load: most visitors never open
        // the dialog, and this keeps a third-party request off the main path.
        if (!loadedOnce) { loadedOnce = true; loadMonth(); }
      });
    });

    dialog.querySelector('[data-close]')!.addEventListener('click', () => dialog.close());
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close();
    });

    render();
  }
</script>

{/*
  is:global is required, not incidental: the calendar cells and time buttons are
  built at runtime, so they never receive Astro's scoping attribute and scoped
  rules would silently not apply. Every selector is "coffee" prefixed.
*/}
<style is:global>
  .coffee {
    width: min(46rem, calc(100vw - 2rem));
    max-height: calc(100vh - 3rem);
    /* reset.css sets `* { margin: 0 }`, which clobbers the UA stylesheet's
       `margin: auto` that centres a modal dialog. Put it back. */
    margin: auto;
    padding: 0;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background-color: var(--color-bg);
    color: var(--color-text-primary);
    overflow: auto;

    /* Closed state. A dialog is display:none until showModal(), so a plain
       transition has nothing to animate from: @starting-style below supplies
       that first frame, and `allow-discrete` on display and overlay keeps the
       dialog painted in the top layer while the exit plays out. Browsers
       without support just pop it in and out, which is a fine floor. */
    opacity: 0;
    transform: translateY(28px);
    transition:
      opacity 460ms cubic-bezier(0.22, 1, 0.36, 1),
      transform 460ms cubic-bezier(0.22, 1, 0.36, 1),
      overlay 460ms allow-discrete,
      display 460ms allow-discrete;
  }

  .coffee[open] {
    opacity: 1;
    transform: translateY(0);
  }

  @starting-style {
    .coffee[open] {
      opacity: 0;
      transform: translateY(28px);
    }
  }

  .coffee::backdrop {
    background-color: rgba(0, 0, 0, 0);
    backdrop-filter: blur(0px);
    transition:
      background-color 460ms ease,
      backdrop-filter 460ms ease,
      overlay 460ms allow-discrete,
      display 460ms allow-discrete;
  }

  .coffee[open]::backdrop {
    background-color: rgba(0, 0, 0, 0.5);
    backdrop-filter: blur(6px);
  }

  @starting-style {
    .coffee[open]::backdrop {
      background-color: rgba(0, 0, 0, 0);
      backdrop-filter: blur(0px);
    }
  }

  /* Keep the discrete display handling (so it still closes cleanly) but drop
     the movement and the blur ramp. */
  @media (prefers-reduced-motion: reduce) {
    .coffee,
    .coffee::backdrop {
      transition-duration: 1ms;
    }

    .coffee,
    .coffee[open] {
      transform: none;
    }
  }

  .coffee__head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-md);
    padding: var(--space-md);
    border-bottom: 1px solid var(--color-border);
  }

  .coffee__title {
    font-size: var(--text-xl);
    margin-bottom: 0.1rem;
  }

  .coffee__sub {
    font-size: var(--text-sm);
    color: var(--color-text-subtle);
  }

  .coffee__close {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border-radius: var(--radius-md);
    color: var(--color-text-muted);
    transition: background-color var(--transition-fast), color var(--transition-fast);
  }

  .coffee__close:hover {
    background-color: var(--color-surface);
    color: var(--color-text-primary);
  }

  /* Calendar left, times right */
  .coffee__body {
    display: grid;
    grid-template-columns: 1fr 1fr;
  }

  .coffee__cal {
    padding: var(--space-md);
    border-right: 1px solid var(--color-border);
  }

  .coffee__cal-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-xs);
    margin-bottom: var(--space-sm);
  }

  .coffee__month {
    font-size: var(--text-base);
    font-weight: 600;
    color: var(--color-text-primary);
  }

  .coffee__nav {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 1.75rem;
    height: 1.75rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    color: var(--color-text-muted);
    transition: border-color var(--transition-fast), color var(--transition-fast);
  }

  .coffee__nav:hover:not(:disabled) {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .coffee__nav:disabled {
    opacity: 0.3;
    cursor: default;
  }

  .coffee__dow,
  .coffee__grid {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 0.15rem;
  }

  .coffee__dow {
    margin-bottom: 0.25rem;
  }

  .coffee__dow span {
    text-align: center;
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--color-text-subtle);
  }

  .coffee__day {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.15rem;
    aspect-ratio: 1;
    border-radius: var(--radius-md);
    font-size: var(--text-sm);
    color: var(--color-text-primary);
    transition: background-color var(--transition-fast), color var(--transition-fast);
  }

  .coffee__day--blank {
    pointer-events: none;
  }

  .coffee__day:disabled {
    color: var(--color-text-subtle);
    opacity: 0.45;
    cursor: default;
  }

  .coffee__day:hover:not(:disabled) {
    background-color: var(--color-surface);
  }

  .coffee__day[aria-pressed='true'] {
    background-color: var(--color-accent);
    color: var(--color-bg);
  }

  /* Availability marker */
  .coffee__day-dot {
    width: 0.3rem;
    height: 0.3rem;
    border-radius: var(--radius-full);
    background-color: var(--color-accent);
  }

  .coffee__day[aria-pressed='true'] .coffee__day-dot {
    background-color: var(--color-bg);
  }

  .coffee__legend {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    margin-top: var(--space-sm);
    font-size: var(--text-xs);
    color: var(--color-text-subtle);
  }

  .coffee__legend-dot {
    width: 0.3rem;
    height: 0.3rem;
    border-radius: var(--radius-full);
    background-color: var(--color-accent);
  }

  /* Times */
  .coffee__slots {
    padding: var(--space-md);
    min-width: 0;
  }

  .coffee__slots-head {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-text-primary);
    margin-bottom: var(--space-sm);
  }

  .coffee__times {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(5.25rem, 1fr));
    gap: 0.4rem;
  }

  .coffee__time {
    padding: 0.45rem 0.4rem;
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-text-muted);
    border: 1px solid var(--color-border);
