---
import { Image } from 'astro:assets';
import headshot from '../assets/images/headshot.jpeg';
import { CV_MAILTO, LINKEDIN } from '../config';

// Booking comes first, it's the primary thing this page is for.
const links = [
  { label: 'coffee', href: '#book', external: false, opensBooking: true },
  { label: 'cv', href: CV_MAILTO, external: false },
  { label: 'contact', href: '#contact', external: false },
  { label: 'linkedin', href: LINKEDIN, external: true },
];
---

<section class="hero" id="top">

  {/* Layer 0: parallax AI network artwork, generated as SVG so it stays sharp
      at any size and costs one small request. */}
  <div class="hero__bg" id="hero-bg" aria-hidden="true"></div>

  {/* Layer 1: colour overlay, keeps the text readable and follows the theme */}
  <div class="hero__overlay" aria-hidden="true"></div>

  {/* Layer 2: content */}
  <div class="hero__inner">
    <div class="hero__content hero-enter">
      <p class="hero__eyebrow">Principal Engineer, Google DeepMind</p>
      <h1 class="hero__name">Sara Javanmardi</h1>

      <p class="hero__tagline">
        {/* Keep each inline span on the same line as the word before it. Astro 7
            collapses a newline sitting between text and an inline element, which
            silently glues the words together. */}
        Over a decade in machine learning and AI, with extensive experience taking
        systems from research into production at <span class="hero__mark">Google</span>.
        Previously <span class="hero__mark">Microsoft</span>.
        PhD from <span class="hero__mark">UC Irvine</span>.
      </p>

      <nav class="hero__links" aria-label="Quick links">
        {links.map((link) => (
          <a
            href={link.href}
            class="hero__link"
            {...(link.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
            {...(link.opensBooking ? { 'data-coffee-open': '' } : {})}
          >
            {link.label}
          </a>
        ))}
      </nav>
    </div>

    <div class="hero__portrait-wrap hero-enter--delay">
      <div class="hero__portrait-ring" aria-hidden="true"></div>
      <Image
        src={headshot}
        alt="Sara Javanmardi"
        class="hero__portrait"
        width={420}
        height={420}
        densities={[1, 2]}
      />
    </div>
  </div>
</section>

<script>
  const bg = document.getElementById('hero-bg');
  const hero = document.querySelector('.hero') as HTMLElement | null;
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (bg && hero && !reducedMotion) {
    let ticking = false;

    const updateParallax = () => {
      const scrollY = window.scrollY;
      // Only apply while hero is visible
      if (scrollY < hero.offsetHeight) {
        bg.style.transform = `translateY(${scrollY * 0.38}px)`;
      }
      ticking = false;
    };

    window.addEventListener('scroll', () => {
      if (!ticking) {
        requestAnimationFrame(updateParallax);
        ticking = true;
      }
    }, { passive: true });
  }
</script>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    min-height: 100vh;
    display: flex;
    align-items: flex-end;
    padding: 0 var(--space-md) var(--space-lg);
    /* Diagonal bottom edge: left side higher than right */
    clip-path: polygon(0 0, 100% 0, 100% 100%, 0 87%);
  }

  /* ── Parallax background ── */
  .hero__bg {
    position: absolute;
    top: -25%;
    left: 0;
    right: 0;
    height: 155%;
    background-image: url('../assets/images/ai-bg.svg');
    background-size: cover;
    background-position: center center;
    will-change: transform;
    z-index: 0;
  }

  /* ── Overlay: solid on left for readability, fades to semi-transparent on right ── */
  .hero__overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    /* Solid behind the copy, fully clear by the right edge. Anything less and
       the cream page colour washes the network out to a grey smear. */
    background: linear-gradient(
      to right,
      var(--color-bg) 0%,
      var(--color-bg) 26%,
      color-mix(in srgb, var(--color-bg) 72%, transparent) 46%,
      transparent 72%
    );
  }

  /* ── Content grid ── */
  .hero__inner {
    position: relative;
    z-index: 2;
    max-width: var(--max-width);
    margin: 0 auto;
    width: 100%;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-lg);
    align-items: flex-end;
    padding-top: var(--space-2xl);
  }

  /* ── Text content ── */
  .hero__content {
    padding-bottom: var(--space-2xl);
  }

  .hero__eyebrow {
    font-size: var(--text-sm);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: var(--space-xs);
  }

  .hero__name {
    letter-spacing: -0.02em;
    margin-bottom: var(--space-sm);
    text-shadow: 0 2px 24px color-mix(in srgb, var(--color-bg) 60%, transparent);
  }

  .hero__tagline {
    font-size: var(--text-lg);
    line-height: 1.6;
    max-width: 30rem;
    margin-bottom: var(--space-lg);
  }

  .hero__mark {
    color: var(--color-text-primary);
    font-weight: 500;
  }

  /* ── Link row: spacing does the separating, no dividers ── */
  .hero__links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 var(--space-md);
  }

  .hero__link {
    padding: 0.35rem 0;
    font-size: var(--text-base);
    color: var(--color-text-muted);
    transition: color var(--transition-fast);
  }

  .hero__link:hover {
    color: var(--color-accent);
  }

  /* ── Circular portrait ── */
  .hero__portrait-wrap {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
    padding-bottom: var(--space-2xl);
  }

  /* Soft halo so the circle sits on the artwork instead of being pasted onto it */
  .hero__portrait-ring {
    position: absolute;
    width: min(26rem, 62vw);
    aspect-ratio: 1;
    border-radius: var(--radius-full);
    background: radial-gradient(
      circle,
      color-mix(in srgb, var(--color-accent) 40%, transparent) 0%,
      transparent 68%
    );
    filter: blur(10px);
  }

  .hero__portrait {
    position: relative;
    display: block;
    width: min(19rem, 50vw);
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: var(--radius-full);
    border: 4px solid color-mix(in srgb, var(--color-bg) 80%, transparent);
    box-shadow: 0 16px 48px rgba(0, 0, 0, 0.32);
  }

  /* ── Responsive ── */
  @media (max-width: 900px) {
    .hero {
      align-items: center;
      padding-bottom: var(--space-2xl);
      clip-path: polygon(0 0, 100% 0, 100% 100%, 0 94%);
    }

    /* Stacked layout puts the portrait on top and the copy below, so the fade
       runs vertically: artwork behind the portrait, solid behind the text. A
       flat wash here just greys the network out without helping legibility. */
    .hero__overlay {
      background: linear-gradient(
        to bottom,
        color-mix(in srgb, var(--color-bg) 15%, transparent) 0%,
        color-mix(in srgb, var(--color-bg) 55%, transparent) 38%,
        var(--color-bg) 60%
      );
    }

    .hero__inner {
      grid-template-columns: 1fr;
      text-align: center;
      align-items: center;
      gap: var(--space-lg);
    }

    .hero__content {
      padding-bottom: 0;
      order: 2;
    }

    .hero__tagline {
      margin-left: auto;
      margin-right: auto;
    }

    .hero__links {
      justify-content: center;
    }

    .hero__portrait-wrap {
      order: 1;
      padding-bottom: 0;
    }

    .hero__portrait {
      width: min(13rem, 45vw);
    }

    .hero__portrait-ring {
      width: min(17rem, 58vw);
    }
  }

  @media (max-width: 560px) {
    .hero__links {
      gap: 0 var(--space-sm);
    }
  }
</style>
