---
import { CV_COMPOSE, LINKEDIN } from '../config';

// Booking comes first, it's the primary thing this page is for.
const links = [
  { label: 'coffee', href: '#book', external: false, opensBooking: true },
  { label: 'cv', href: CV_COMPOSE, external: true, isCompose: true },
  { label: 'contact', href: '#contact', external: false },
  { label: 'linkedin', href: LINKEDIN, external: true },
];
---

<section class="hero" id="top">

  {/* Layer 0: live network animation. Drifting nodes connect when close and
      each new connection fires a brief glow, like synapses. Palette comes from
      the --net-* theme tokens, so the toggle recolours it live. */}
  <div class="hero__bg" id="hero-bg" aria-hidden="true">
    <canvas data-net></canvas>
  </div>

  {/* Layer 1: colour overlay, keeps the text readable and follows the theme */}
  <div class="hero__overlay" aria-hidden="true"></div>

  {/* Layer 2: content */}
  <div class="hero__inner">
    <div class="hero__content hero-enter">
      <p class="hero__eyebrow">Principal Engineer, Google DeepMind</p>
      <h1 class="hero__name">Sara Javanmardi</h1>

      <p class="hero__tagline">
        Over a decade in machine learning and AI, with extensive experience in deployment.
      </p>

      <nav class="hero__links" aria-label="Quick links">
        {links.map((link) => (
          <a
            href={link.href}
            class="hero__link"
            {...(link.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
            {...(link.opensBooking ? { 'data-coffee-open': '' } : {})}
            {...(link.isCompose ? { 'data-compose-cv': '' } : {})}
          >
            {link.label}
          </a>
        ))}
      </nav>
    </div>

    <div class="hero__portrait-wrap hero-enter--delay">
      <div class="hero__portrait-ring" aria-hidden="true"></div>
      {/* Plain <img> against pre-built files in public/, not Astro's <Image>.
          <Image> optimises during the build, and when the builder lacks sharp
          Astro falls back to /_image?href=... URLs that need a server to
          answer. On a static deploy those 404 and the photo never loads.
          Regenerate with: node scripts/make-headshot.mjs */}
      <img
        src="/headshot.webp"
        srcset="/headshot.webp 1x, /headshot@2x.webp 2x"
        alt="Sara Javanmardi"
        class="hero__portrait"
        width="420"
        height="420"
        fetchpriority="high"
        decoding="async"
      />
    </div>
  </div>
</section>

<script>
  import { CV_REQUEST, composeUrl, isTouchPrimary } from '../config';

  // The href ships as the Gmail web URL so it works without JS, which is right
  // on desktop. On a touch device that page usually redirects to the inbox and
  // loses the draft, so point it at the native mail app instead.
  if (isTouchPrimary()) {
    const cv = document.querySelector<HTMLAnchorElement>('[data-compose-cv]');
    if (cv) {
      cv.href = composeUrl(CV_REQUEST);
      // mailto: hands off to another app; a new tab would be left behind blank.
      cv.removeAttribute('target');
      cv.removeAttribute('rel');
    }
  }

  const bg = document.getElementById('hero-bg');
  const hero = document.querySelector('.hero') as HTMLElement | null;
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // ── Parallax ─────────────────────────────────────────────────────────────
  if (bg && hero && !reducedMotion) {
    let ticking = false;

    const updateParallax = () => {
      const scrollY = window.scrollY;
      // Only apply while hero is visible
      if (scrollY < hero.offsetHeight) {
        bg.style.transform = `translateY(${scrollY * 0.38}px)`;
      }
      ticking = false;
    };

    window.addEventListener('scroll', () => {
      if (!ticking) {
        requestAnimationFrame(updateParallax);
        ticking = true;
      }
    }, { passive: true });
  }

  // ── Network animation ────────────────────────────────────────────────────
  // A sparse field of slowly drifting nodes. When two come within CONNECT_R a
  // thread fades in, opacity scaled by proximity. The first frame a pair
  // connects fires a one-off event: both endpoints bloom and the new thread
  // starts brighter, decaying over about a second. Slow drift, no physics;
  // the life is in the connecting.
  const canvas = bg?.querySelector<HTMLCanvasElement>('[data-net]');

  if (bg && canvas) {
    const ctx = canvas.getContext('2d')!;

    const CONNECT_R = 150;      // px within which a thread forms
    const MARGIN = 80;          // wrap margin so nodes never pop at the edges
    const LINE_MAX = 0.42;      // steady-state thread opacity at zero distance
    const FLASH_BOOST = 0.22;   // extra thread opacity at the connection moment
    const GLOW_DECAY = 2.4;     // 1/s, endpoint bloom fade
    const FLASH_LIFE = 1.4;     // s, how long a connection event lingers

    // Line count in a cluster grows with the square of its size, so dense
    // patches turn into hairballs. Instead of a hard cap (lines popping in
    // and out as rank order changes), each node has a soft budget: carrying
    // more than this many threads dims all of them proportionally. The
    // degree is smoothed over time, so the dimming eases rather than steps.
    const CROWD_BUDGET = 3;
    const CROWD_EASE = 2.5;     // 1/s, how fast perceived crowding adapts

    type Node = {
      x: number; y: number;
      vx: number; vy: number;
      phase: number;            // breathing offset so the field shimmers unevenly
      r: number;                // core radius
      glow: number;             // 0..1, set to 1 when a connection fires
      crowd: number;            // smoothed thread count, drives the line budget
    };

    let W = 0;
    let H = 0;
    let nodes: Node[] = [];
    let linked = new Set<string>();
    const flashes = new Map<string, number>(); // pair key -> seconds since connect

    // Palette comes from the theme tokens as bare R,G,B triplets; the canvas
    // composes its own alpha per frame.
    let colors = { line: '', node: '', glow: '' };
    let halo = 1;
    let glowSprite = document.createElement('canvas');

    const readTheme = () => {
      const s = getComputedStyle(document.documentElement);
      colors = {
        line: s.getPropertyValue('--net-line').trim(),
        node: s.getPropertyValue('--net-node').trim(),
        glow: s.getPropertyValue('--net-glow').trim(),
      };
      halo = parseFloat(s.getPropertyValue('--net-halo')) || 1;
      // Pre-render the halo once per theme: a radial falloff drawn per node
      // per frame would burn the frame budget for an identical result.
      glowSprite = document.createElement('canvas');
      glowSprite.width = glowSprite.height = 64;
      const g = glowSprite.getContext('2d')!;
      const grad = g.createRadialGradient(32, 32, 0, 32, 32, 32);
      grad.addColorStop(0, `rgba(${colors.glow}, 0.55)`);
      grad.addColorStop(1, `rgba(${colors.glow}, 0)`);
      g.fillStyle = grad;
      g.fillRect(0, 0, 64, 64);
    };

    const key = (i: number, j: number) => `${i}:${j}`;

    /**
     * Deterministic RNG, so seeding always produces the same field.
     *
     * This used to use Math.random(), which meant every reseed dealt a brand
     * new arrangement. Reseeding happens on resize, and on mobile the address
     * bar hiding fires resize constantly, so the artwork visibly jumped
     * between layouts. With reduced motion on there is no drift to disguise
     * it, so it read as the background flicking between different images.
     */
    const SEED = 0x9e3779b9;
    let rngState = SEED;
    const rand = () => {
      rngState = (rngState + 0x6d2b79f5) | 0;
      let t = Math.imul(rngState ^ (rngState >>> 15), 1 | rngState);
      t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
      return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
    };

    const seed = () => {
      // Rewind, or the generator would carry on from wherever the last seeding
      // left it and hand back a different field anyway.
      rngState = SEED;
      // Density scales with area so phones are not overcrowded and big
      // monitors are not empty. Capped: this is ambience, not a screensaver.
      const count = Math.max(36, Math.min(90, Math.round((W * H) / 22000)));
      nodes = Array.from({ length: count }, () => {
        const angle = rand() * Math.PI * 2;
        const speed = 4 + rand() * 5; // px/s, slow deliberate drift
        return {
          x: rand() * W,
          y: rand() * H,
          vx: Math.cos(angle) * speed,
          vy: Math.sin(angle) * speed,
          phase: rand() * Math.PI * 2,
          r: 1.3 + rand() * 0.9,
          glow: 0,
          crowd: 0,
        };
      });

      // Prime pairs already in range so the first frame does not fire every
      // connection at once like a camera flash. Crowd starts at the real
      // degree so dense patches are born dimmed instead of easing there.
      linked = new Set();
      flashes.clear();
      for (let i = 0; i < nodes.length; i++) {
        for (let j = i + 1; j < nodes.length; j++) {
          const dx = nodes[i].x - nodes[j].x;
          const dy = nodes[i].y - nodes[j].y;
          if (dx * dx + dy * dy < CONNECT_R * CONNECT_R) {
            linked.add(key(i, j));
            nodes[i].crowd++;
            nodes[j].crowd++;
          }
        }
      }
    };

    const resize = () => {
      // offsetWidth/Height, not getBoundingClientRect: the parallax transform
      // must not leak into the canvas resolution.
      W = bg.offsetWidth;
      H = bg.offsetHeight;
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      canvas.width = Math.round(W * dpr);
      canvas.height = Math.round(H * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      seed();
    };

    const frame = (dt: number, t: number) => {
      for (const n of nodes) {
        n.x += n.vx * dt;
        n.y += n.vy * dt;
        if (n.x < -MARGIN) n.x += W + MARGIN * 2;
        if (n.x > W + MARGIN) n.x -= W + MARGIN * 2;
        if (n.y < -MARGIN) n.y += H + MARGIN * 2;
        if (n.y > H + MARGIN) n.y -= H + MARGIN * 2;
        n.glow *= Math.exp(-dt * GLOW_DECAY);
      }

      for (const [k, age] of flashes) {
        const next = age + dt;
        if (next > FLASH_LIFE) flashes.delete(k);
        else flashes.set(k, next);
      }

      ctx.clearRect(0, 0, W, H);

      // Pass 1: find threads and count each node's degree. Drawing has to
      // wait, because a thread's opacity depends on how crowded both of its
      // endpoints are, and that is only known once every pair is counted.
      const nextLinked = new Set<string>();
      const deg = new Array(nodes.length).fill(0);
      const edges: { i: number; j: number; closeness: number; k: string }[] = [];
      for (let i = 0; i < nodes.length; i++) {
        for (let j = i + 1; j < nodes.length; j++) {
          const dx = nodes[i].x - nodes[j].x;
          const dy = nodes[i].y - nodes[j].y;
          const d2 = dx * dx + dy * dy;
          if (d2 >= CONNECT_R * CONNECT_R) continue;

          const k = key(i, j);
          nextLinked.add(k);
          deg[i]++;
          deg[j]++;
          if (!linked.has(k)) {
            // The connection moment: thread flashes, endpoints bloom
            flashes.set(k, 0);
            nodes[i].glow = 1;
            nodes[j].glow = 1;
          }
          edges.push({ i, j, closeness: 1 - Math.sqrt(d2) / CONNECT_R, k });
        }
      }
      linked = nextLinked;

      // Perceived crowding chases the real degree instead of jumping to it,
      // so the dimming eases in and out. dt of 0 is the static frame; it has
      // no next frame to ease over, so it takes the real value directly.
      const blend = dt === 0 ? 1 : 1 - Math.exp(-dt * CROWD_EASE);
      for (let i = 0; i < nodes.length; i++) {
        nodes[i].crowd += (deg[i] - nodes[i].crowd) * blend;
      }

      // Pass 2: draw, each thread paying for its endpoints' crowding
      ctx.lineWidth = 1;
      for (const e of edges) {
        const crowd = (nodes[e.i].crowd + nodes[e.j].crowd) / 2;
        const budget = Math.min(1, CROWD_BUDGET / Math.max(1, crowd));
        const flashAge = flashes.get(e.k);
        const flash = flashAge === undefined ? 0 : Math.exp(-flashAge * 2.6);
        const alpha = (e.closeness * LINE_MAX + flash * FLASH_BOOST) * budget;

        ctx.strokeStyle = `rgba(${colors.line}, ${alpha})`;
        ctx.beginPath();
        ctx.moveTo(nodes[e.i].x, nodes[e.i].y);
        ctx.lineTo(nodes[e.j].x, nodes[e.j].y);
        ctx.stroke();
      }

      // Nodes: soft halo sprite under a solid core, both breathing gently
      for (const n of nodes) {
        const breath = 0.5 + 0.5 * Math.sin(t * 0.45 + n.phase);
        const haloR = 14 + 4 * breath + 6 * n.glow;
        ctx.globalAlpha = Math.min(1, (0.1 + 0.06 * breath + 0.2 * n.glow) * halo);
        ctx.drawImage(glowSprite, n.x - haloR, n.y - haloR, haloR * 2, haloR * 2);
        ctx.globalAlpha = 1;

        // Kept translucent so nodes sit in the field rather than punching
        // through it. Opaque cores read as specks on a light background.
        ctx.fillStyle = `rgba(${colors.node}, ${0.3 + 0.28 * breath + 0.15 * n.glow})`;
        ctx.beginPath();
        ctx.arc(n.x, n.y, n.r + n.glow * 0.45, 0, Math.PI * 2);
        ctx.fill();
      }
    };

    // ── Loop control: run only while the hero is on screen ────────────────
    let rafId = 0;
    let last = 0;
    let running = false;

    const loop = (now: number) => {
      const dt = Math.min((now - last) / 1000, 0.05); // clamp tab-switch jumps
      last = now;
      frame(dt, now / 1000);
      if (running) rafId = requestAnimationFrame(loop);
    };

    const start = () => {
      if (running || reducedMotion) return;
      running = true;
      last = performance.now();
      rafId = requestAnimationFrame(loop);
    };

    const stop = () => {
      running = false;
      cancelAnimationFrame(rafId);
    };

    readTheme();
    resize();

    if (reducedMotion) {
      // The look without the movement: one static frame of the same field
      frame(0, 0);
    } else {
      new IntersectionObserver(
        (entries) => (entries[0].isIntersecting ? start() : stop()),
      ).observe(bg);
    }

    let resizeTimer = 0;
    window.addEventListener('resize', () => {
      clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(() => {
        resize();
        if (reducedMotion) frame(0, 0);
      }, 150);
    });

    // Recolour live when the theme toggle flips data-theme
    new MutationObserver(() => {
      readTheme();
      if (reducedMotion) frame(0, 0);
    }).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
  }
</script>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    min-height: 100vh;
    display: flex;
    /* Centred, not bottom-anchored: the old flex-end was for the standing
       cutout figure, and it left the circular portrait sunk in the bottom
       third. The small bottom padding offsets the diagonal cut below. */
    align-items: center;
    padding: 0 var(--space-md) 6vh;
    /* Diagonal bottom edge: left side higher than right */
    clip-path: polygon(0 0, 100% 0, 100% 100%, 0 87%);
  }

  /* ── Parallax background: canvas animation over a theme-aware wash ── */
  .hero__bg {
    position: absolute;
    top: -25%;
    left: 0;
    right: 0;
    height: 155%;
    /* Transparent on the left so the page colour carries through, deepening
       toward the right. The canvas above it is fully transparent, which is
       what keeps light mode light instead of a dark slab on a cream page. */
    background: linear-gradient(to right, transparent 25%, var(--hero-tint) 100%);
    will-change: transform;
    z-index: 0;
  }

  .hero__bg canvas {
    display: block;
    width: 100%;
    height: 100%;
  }

  /* ── Overlay: solid on left for readability, fades to semi-transparent on right ── */
  .hero__overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    /* Solid behind the copy, fully clear by the right edge. Anything less and
       the cream page colour washes the network out to a grey smear. */
    background: linear-gradient(
      to right,
      var(--color-bg) 0%,
      var(--color-bg) 26%,
      color-mix(in srgb, var(--color-bg) 72%, transparent) 46%,
      transparent 72%
    );
  }

  /* ── Content grid ── */
  .hero__inner {
    position: relative;
    z-index: 2;
    max-width: var(--max-width);
    margin: 0 auto;
    width: 100%;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-lg);
    align-items: center;
  }

  .hero__eyebrow {
    font-size: var(--text-sm);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-text-accent);
    margin-bottom: var(--space-xs);
  }

  .hero__name {
    letter-spacing: -0.02em;
    margin-bottom: var(--space-sm);
    text-shadow: 0 2px 24px color-mix(in srgb, var(--color-bg) 60%, transparent);
  }

  .hero__tagline {
    font-size: var(--text-lg);
    line-height: 1.6;
    max-width: 30rem;
    margin-bottom: var(--space-lg);
  }

  /* ── Link row: spacing does the separating, no dividers ── */
  .hero__links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 var(--space-md);
  }

  .hero__link {
    padding: 0.35rem 0;
    font-size: var(--text-base);
    color: var(--color-text-muted);
    transition: color var(--transition-fast);
  }

  .hero__link:hover {
    color: var(--color-link);
  }

  /* ── Circular portrait ── */
  .hero__portrait-wrap {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  /* Soft halo so the circle sits on the artwork instead of being pasted onto it */
  /* Desktop only: the max-width 900px block below sets its own size. Sized to
     roughly 1.15x the portrait, the same proportion the stacked layout uses. */
  .hero__portrait-ring {
    position: absolute;
    width: min(22rem, 62vw);
    aspect-ratio: 1;
    border-radius: var(--radius-full);
    background: radial-gradient(
      circle,
      color-mix(in srgb, var(--color-accent) 40%, transparent) 0%,
      transparent 68%
    );
    filter: blur(10px);
  }

  .hero__portrait {
    position: relative;
    display: block;
    width: min(19rem, 50vw);
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: var(--radius-full);
  }

  /* ── Responsive ── */
  @media (max-width: 900px) {
    .hero {
      align-items: center;
      padding-bottom: var(--space-2xl);
      clip-path: polygon(0 0, 100% 0, 100% 100%, 0 94%);
    }

    /* Stacked layout puts the portrait on top and the copy below, so the fade
       runs vertically: artwork behind the portrait, solid behind the text. A
       flat wash here just greys the network out without helping legibility. */
    .hero__overlay {
      background: linear-gradient(
        to bottom,
        color-mix(in srgb, var(--color-bg) 15%, transparent) 0%,
        color-mix(in srgb, var(--color-bg) 55%, transparent) 38%,
        var(--color-bg) 60%
      );
    }

    .hero__inner {
      grid-template-columns: 1fr;
      text-align: center;
      align-items: center;
      gap: var(--space-lg);
    }

    .hero__content {
      order: 2;
    }

    .hero__tagline {
      margin-left: auto;
      margin-right: auto;
    }

    .hero__links {
      justify-content: center;
    }

    .hero__portrait-wrap {
      order: 1;
      padding-bottom: 0;
    }

    .hero__portrait {
      width: min(13rem, 45vw);
    }

    .hero__portrait-ring {
      width: min(17rem, 58vw);
    }
  }

  @media (max-width: 560px) {
    .hero__links {
      gap: 0 var(--space-sm);
    }
  }
</style>
