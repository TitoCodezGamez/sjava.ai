---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import googleLogo from '../assets/logos/google-logo.svg';
import microsoftLogo from '../assets/logos/microsoft-logo.svg';

const logoMap: Record<string, ImageMetadata> = {
  google: googleLogo,
  microsoft: microsoftLogo,
};

// Durations are computed from the start and end months below rather than
// hardcoded, so they cannot silently go stale. They are evaluated at build
// time, so a rebuild refreshes them: on Cloudflare Pages that happens on every
// push, and a scheduled deploy would keep them exact if that ever matters.

type Role = {
  title: string;
  /** 'YYYY-MM'. Omit `end` for a role still held. */
  start: string;
  end?: string;
  /** One short line, not a paragraph. LinkedIn carries the long version. */
  focus?: string;
};

type Company = {
  company: string;
  logoKey: string;
  location: string;
  roles: Role[];
};

const MONTH_NAMES = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];

const parseMonth = (value: string) => {
  const [year, month] = value.split('-').map(Number);
  return { year, month };
};

const formatMonth = (value: string) => {
  const { year, month } = parseMonth(value);
  return `${MONTH_NAMES[month - 1]} ${year}`;
};

const now = new Date();
const today = { year: now.getFullYear(), month: now.getMonth() + 1 };

const monthsBetween = (from: string, to?: string) => {
  const a = parseMonth(from);
  const b = to ? parseMonth(to) : today;
  return (b.year - a.year) * 12 + (b.month - a.month);
};

/** 27 -> "2 yrs 3 mos", matching the way LinkedIn phrases tenure. */
const humanizeMonths = (total: number) => {
  const years = Math.floor(total / 12);
  const months = total % 12;
  const parts: string[] = [];
  if (years) parts.push(`${years} ${years === 1 ? 'yr' : 'yrs'}`);
  if (months) parts.push(`${months} ${months === 1 ? 'mo' : 'mos'}`);
  return parts.join(' ') || '<1 mo';
};

const roleDates = (role: Role) =>
  `${formatMonth(role.start)} – ${role.end ? formatMonth(role.end) : 'Present'}`;

/** Earliest start to latest end across all roles at a company. */
const companyTenure = (company: Company) => {
  const earliest = company.roles.reduce((a, r) => (r.start < a ? r.start : a), company.roles[0].start);
  const stillThere = company.roles.some((r) => !r.end);
  const latest = stillThere
    ? undefined
    : company.roles.reduce((a, r) => (r.end && r.end > a ? r.end : a), company.roles[0].end!);
  return humanizeMonths(monthsBetween(earliest, latest));
};

const companies: Company[] = [
  {
    company: 'Google',
    logoKey: 'google',
    location: 'Mountain View, CA',
    roles: [
      {
        title: 'Principal Engineer',
        start: '2024-04',
        // DRAFT: describes what the level generally entails, not confirmed
        // detail about Sara's current charter. Have her sign off on this line.
        focus: 'Google DeepMind: technical direction for ranking and machine learning',
      },
      {
        title: 'Senior Staff Software Engineer',
        start: '2021-10',
        end: '2024-04',
        focus: 'Google Brain: machine learning for Search and Ads',
      },
      {
        title: 'Staff Software Engineer',
        start: '2018-04',
        end: '2021-10',
        focus: 'Technical lead for Fresh Autocomplete and misinformation handling',
      },
      {
        title: 'Senior Software Engineer, Technical Lead',
        start: '2015-04',
        end: '2018-03',
        focus: 'Autocomplete infrastructure and ranking',
      },
    ],
  },
  {
    company: 'Microsoft',
    logoKey: 'microsoft',
    location: 'Bellevue, WA',
    roles: [
      {
        title: 'Software Engineer II (RSDE)',
        start: '2011-09',
        end: '2013-12',
        focus: 'Bing relevance: core ranking and personalization',
      },
    ],
  },
];
---

<section class="section experience" id="experience">
  <div class="section__inner">
    <header class="section__header" data-reveal>
      <span class="section__label">Experience</span>
      <h2 class="section__title">Career timeline</h2>
      <p class="section__subtitle">
        Over a decade of machine learning and AI work at Google, from Search ranking
        and autocomplete through to deployment at scale, following earlier work on
        Bing relevance at Microsoft.
      </p>
    </header>

    <ol class="timeline">
      {companies.map((co, i) => (
        <li class="timeline__co" data-reveal data-reveal-delay={String(i + 1)}>
          <div class="timeline__co-header">
            <Image
              src={logoMap[co.logoKey]}
              alt={`${co.company} logo`}
              class="timeline__logo"
              width={36}
              height={36}
            />
            <h3 class="timeline__co-name">{co.company}</h3>
            <span class="timeline__co-meta">{companyTenure(co)} · {co.location}</span>
          </div>

          <ol class="roles">
            {co.roles.map((role) => (
              <li class="role">
                <div class="role__main">
                  <h4 class="role__title">{role.title}</h4>
                  {role.focus && <p class="role__focus">{role.focus}</p>}
                </div>
                <p class="role__dates">
                  {roleDates(role)}
                  <span class="role__duration">{humanizeMonths(monthsBetween(role.start, role.end))}</span>
                </p>
              </li>
            ))}
          </ol>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .timeline {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  /* ── Company ── */
  .timeline__co-header {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    padding-bottom: var(--space-xs);
    border-bottom: 1px solid var(--color-border);
    margin-bottom: var(--space-xs);
  }

  .timeline__logo {
    flex-shrink: 0;
    width: 1.5rem;
    height: 1.5rem;
    object-fit: contain;
  }

  .timeline__co-name {
    font-family: var(--font-body);
    font-size: var(--text-lg);
    font-weight: 600;
  }

  .timeline__co-meta {
    font-size: var(--text-sm);
    color: var(--color-text-subtle);
    margin-left: auto;
    text-align: right;
  }

  /* ── Roles: one compact row each ── */
  .role {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-md);
    padding: 0.5rem 0;
    border-bottom: 1px solid var(--color-border);
  }

  .role:last-child {
    border-bottom: none;
  }

  .role__main {
    min-width: 0;
  }

  .role__title {
    font-family: var(--font-body);
    font-size: var(--text-base);
    font-weight: 600;
    line-height: 1.35;
  }

  .role__focus {
    font-size: var(--text-sm);
    color: var(--color-text-subtle);
    line-height: 1.45;
  }

  .role__dates {
    flex-shrink: 0;
    font-size: var(--text-sm);
    color: var(--color-text-subtle);
    text-align: right;
    white-space: nowrap;
  }

  .role__duration {
    display: block;
    font-size: var(--text-xs);
    opacity: 0.8;
  }

  @media (max-width: 640px) {
    .timeline__co-header {
      flex-wrap: wrap;
    }

    .timeline__co-meta {
      margin-left: 0;
      flex-basis: 100%;
      text-align: left;
    }

    .role {
      flex-direction: column;
      gap: 0.15rem;
    }

    .role__dates {
      text-align: left;
    }

    .role__duration {
      display: inline;
      margin-left: 0.4rem;
    }
  }
</style>
